{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  minimumReleaseAge: '48 hours',
  extends: [
    'config:best-practices',
    'helpers:pinGitHubActionDigestsToSemver',
    ':dependencyDashboard',
  ],
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  packageRules: [
    {
      matchUpdateTypes: [
        'pinDigest',
      ],
      minimumReleaseAge: null,
    },
    {
      // Our own backend image - we control the release, no need to wait
      // out the usual third-party stability window.
      matchDatasources: [
        'docker',
      ],
      matchDepNames: [
        'docker.io/powerofcreation/imp-list-backend',
        'powerofcreation/imp-list-backend',
      ],
      minimumReleaseAge: null,
      // Default docker versioning treats "-rc.N" as a compatibility suffix
      // (like "-alpine"), so it's never proposed as an update target. semver
      // versioning treats it as a real pre-release instead - but by default
      // Renovate still won't jump a stable version to an unstable one, hence
      // ignoreUnstable: false.
      versioning: 'semver',
      ignoreUnstable: false,
    },
    {
      matchFileNames: [
        'frontend/**',
      ],
      addLabels: [
        'frontend',
      ],
    },
    {
      matchFileNames: [
        'backend/**',
      ],
      addLabels: [
        'backend',
      ],
    },
    {
      matchFileNames: [
        '.github/**',
        'renovate.json5',
      ],
      addLabels: [
        'actions',
      ],
    },
    {
      matchFileNames: [
        'charts/**',
      ],
      addLabels: [
        'helm',
      ],
    },
    {
      matchFileNames: [
        'frontend/**',
      ],
      matchPackageNames: [
        'expo',
        '/^expo-/',
        '/^@expo//',
        '!expo-doctor',
        '!expo-sqlite-mock',
      ],
      groupName: 'expo sdk packages',
      groupSlug: 'expo-sdk',
      rangeStrategy: 'replace',
    },
    {
      // Expo and React Native are not backwards compatible across arbitrary
      // versions. Keep new releases visible in the Dependency Dashboard, but
      // only create their PRs as part of a deliberate Expo SDK upgrade.
      matchFileNames: [
        'frontend/**',
      ],
      matchPackageNames: [
        'react',
        'react-dom',
        'react-test-renderer',
        '@types/react-test-renderer',
        'react-native',
        'react-native-gesture-handler',
        'react-native-get-random-values',
        'react-native-reanimated',
        'react-native-safe-area-context',
        'react-native-screens',
        'react-native-web',
        'react-native-worklets',
        '@react-native-async-storage/async-storage',
        '/^@react-navigation//',
      ],
      dependencyDashboardApproval: true,
    },
    {
      // aktiviert Updates der `go`-Direktive in go.mod (per Default deaktiviert)
      matchDatasources: [
        'golang-version',
      ],
      matchDepNames: [
        'go',
      ],
      rangeStrategy: 'bump',
    },
    {
      // Ohne gomodTidy bleibt go.sum nach einem Bump stale (z.B. alter
      // Versions-Hash neben dem neuen stehen).
      matchManagers: [
        'gomod',
      ],
      postUpdateOptions: [
        'gomodTidy',
      ],
    },
    {
      // Go-Version in backend/go.mod und im golang-Image in backend/Dockerfile gemeinsam anheben
      matchDatasources: [
        'golang-version',
        'docker',
      ],
      matchDepNames: [
        'go',
        'golang',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      groupName: 'go version',
      groupSlug: 'go-version',
    },
    {
      // values.yaml's backend.image.tag (helm-values manager) and
      // Chart.yaml's appVersion (custom regex manager below) have
      // different depNames, so without this they'd land in separate
      // branches/PRs.
      matchFileNames: [
        'charts/imp-list/Chart.yaml',
        'charts/imp-list/values.yaml',
      ],
      matchDatasources: [
        'docker',
      ],
      groupName: 'imp-list chart appVersion',
      groupSlug: 'imp-list-chart-appversion',
    },
    {
      // Full tag (cli-X.Y.Z) in MAESTRO_VERSION: the digest lookup fetches the
      // release by currentValue, so extractVersion would 404 on the bare version.
      matchDepNames: [
        'mobile-dev-inc/Maestro',
      ],
      versioning: 'regex:^cli-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
  ],
  customManagers: [
    {
      // Tools pinned in workflows via a "# renovate: datasource=… depName=…"
      // comment above FOO_VERSION; an optional FOO_SHA256 line below is
      // bumped too (github-release-attachments datasource).
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github\\/(workflows|actions)\\/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+\\w+_VERSION: ["\']?(?<currentValue>[^"\'\\s]+)["\']?(?:\\s+\\w+_SHA256: (?<currentDigest>[a-f0-9]{64}))?',
      ],
    },
    {
      // Images inside run:/heredoc scripts (e.g. the smoke-test Postgres),
      // which the github-actions manager doesn't parse.
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github\\/workflows\\/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '\\s(?<depName>[a-z0-9][a-z0-9./-]*):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github\\/workflows\\/renovate\\.yml$/',
      ],
      matchStrings: [
        'renovate-version: (?<currentValue>[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      depNameTemplate: 'ghcr.io/renovatebot/renovate',
      datasourceTemplate: 'docker',
      versioningTemplate: 'semver',
    },
    {
      // Renovate's built-in helm-values manager only bumps values.yaml's
      // backend.image.tag - Chart.yaml's appVersion needs its own regex
      // manager to stay in step with it.
      customType: 'regex',
      managerFilePatterns: [
        '/^charts\\/imp-list\\/Chart\\.yaml$/',
      ],
      matchStrings: [
        'appVersion: "(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'powerofcreation/imp-list-backend',
      datasourceTemplate: 'docker',
      versioningTemplate: 'semver',
    },
  ],
}
