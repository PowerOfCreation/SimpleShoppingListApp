{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  minimumReleaseAge: '48 hours',
  extends: [
    'config:best-practices',
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  packageRules: [
    {
      matchUpdateTypes: [
        'pinDigest',
      ],
      minimumReleaseAge: null,
    },
    {
      matchFileNames: [
        'frontend/**',
      ],
      addLabels: [
        'frontend',
      ],
    },
    {
      matchFileNames: [
        'backend/**',
      ],
      addLabels: [
        'backend',
      ],
    },
    {
      matchFileNames: [
        '.github/**',
        'renovate.json5',
      ],
      addLabels: [
        'actions',
      ],
    },
    {
      matchFileNames: [
        'charts/**',
      ],
      addLabels: [
        'helm',
      ],
    },
    {
      matchFileNames: [
        'frontend/**',
      ],
      matchPackageNames: [
        'expo',
        'react',
        'react-dom',
        'react-test-renderer',
        '@types/react-test-renderer',
        'react-native',
        'react-native-gesture-handler',
        'react-native-reanimated',
        'react-native-safe-area-context',
        'react-native-screens',
        'react-native-web',
        'react-native-worklets',
        '@react-native-async-storage/async-storage',
        '/^expo-/',
        '/^@expo//',
        '/^@react-navigation//',
      ],
      groupName: 'expo sdk',
      groupSlug: 'expo-sdk',
      rangeStrategy: 'replace',
    },
    {
      // aktiviert Updates der `go`-Direktive in go.mod (per Default deaktiviert)
      matchDatasources: [
        'golang-version',
      ],
      matchDepNames: [
        'go',
      ],
      rangeStrategy: 'bump',
    },
    {
      // Go-Version in backend/go.mod und im golang-Image in backend/Dockerfile gemeinsam anheben
      matchDatasources: [
        'golang-version',
        'docker',
      ],
      matchDepNames: [
        'go',
        'golang',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      groupName: 'go version',
      groupSlug: 'go-version',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github\\/workflows\\/renovate\\.yml$/',
      ],
      matchStrings: [
        'renovate-version: (?<currentValue>[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      depNameTemplate: 'ghcr.io/renovatebot/renovate',
      datasourceTemplate: 'docker',
      versioningTemplate: 'semver',
    },
    {
      // Renovate's built-in helm-values manager only bumps values.yaml's
      // image.tag - Chart.yaml's appVersion needs its own regex manager to
      // stay in step with it.
      customType: 'regex',
      managerFilePatterns: [
        '/^charts\\/backend\\/Chart\\.yaml$/',
      ],
      matchStrings: [
        'appVersion: "(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'powerofcreation/imp-list-backend',
      datasourceTemplate: 'docker',
      versioningTemplate: 'semver',
    },
  ],
}
