{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "backend",
  "type": "object",
  "required": ["image", "service", "secret"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["port", "targetPort"],
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" }
      },
      "if": {
        "properties": { "enabled": { "const": true } }
      },
      "then": {
        "properties": { "host": { "type": "string", "minLength": 1 } },
        "required": ["host"]
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "secret": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "databaseUrl": { "type": "string" },
        "keycloakIssuer": { "type": "string" },
        "keycloakClientId": { "type": "string" }
      },
      "oneOf": [
        {
          "properties": { "existingSecret": { "type": "string", "minLength": 1 } },
          "required": ["existingSecret"]
        },
        {
          "properties": {
            "existingSecret": { "type": "string", "maxLength": 0 },
            "databaseUrl": { "type": "string", "minLength": 1 },
            "keycloakIssuer": { "type": "string", "minLength": 1 },
            "keycloakClientId": { "type": "string", "minLength": 1 }
          },
          "required": ["databaseUrl", "keycloakIssuer", "keycloakClientId"]
        }
      ]
    }
  }
}
