{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "imp-list",
  "type": "object",
  "required": ["backend"],
  "properties": {
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          },
          "if": {
            "properties": { "enabled": { "const": true } }
          },
          "then": {
            "properties": { "secretName": { "type": "string", "minLength": 1 } },
            "required": ["secretName"]
          }
        }
      },
      "if": {
        "properties": { "enabled": { "const": true } }
      },
      "then": {
        "properties": { "host": { "type": "string", "minLength": 1 } },
        "required": ["host"]
      }
    },
    "backend": {
      "type": "object",
      "required": ["image", "service", "secret", "keycloak"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "service": {
          "type": "object",
          "required": ["port", "targetPort"],
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "pathType": { "type": "string" }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "keycloak": {
          "type": "object",
          "properties": {
            "existingConfigMap": { "type": "string" },
            "existingConfigMapKeys": {
              "type": "object",
              "properties": {
                "issuer": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" },
                "clientId": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" }
              }
            },
            "issuer": { "type": "string" },
            "clientId": { "type": "string" }
          },
          "oneOf": [
            {
              "properties": { "existingConfigMap": { "type": "string", "minLength": 1 } },
              "required": ["existingConfigMap"]
            },
            {
              "properties": {
                "existingConfigMap": { "type": "string", "maxLength": 0 },
                "issuer": { "type": "string", "minLength": 1 },
                "clientId": { "type": "string", "minLength": 1 }
              },
              "required": ["issuer", "clientId"]
            }
          ]
        },
        "secret": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "existingSecretKeys": {
              "type": "object",
              "properties": {
                "databaseUrl": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" }
              }
            },
            "databaseUrl": { "type": "string" }
          },
          "oneOf": [
            {
              "properties": { "existingSecret": { "type": "string", "minLength": 1 } },
              "required": ["existingSecret"]
            },
            {
              "properties": {
                "existingSecret": { "type": "string", "maxLength": 0 },
                "databaseUrl": { "type": "string", "minLength": 1 }
              },
              "required": ["databaseUrl"]
            }
          ]
        }
      }
    }
  }
}
