# Copy to .env to enable the optional Keycloak login.
# Without these the app still works — the account screen just reports that
# login is not configured.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle and are therefore not
# secret. That is fine here: the Keycloak client is a public client using PKCE
# and has no client secret.
EXPO_PUBLIC_KEYCLOAK_ISSUER=https://sso.ops.light-dev-solutions.de/realms/user-apps
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=shopping-list

# Backend base URL for list sync. This one is *not* meant to go in a local
# .env — dev and production values are already checked in as
# .env.development / .env.production, which Expo picks between automatically
# based on the build (see those files for why). Only set EXPO_PUBLIC_API_URL
# here yourself if you need to point at something else entirely (a
# teammate's tunnel, a staging backend, ...); without it, sync is simply
# disabled, the same way login degrades without the Keycloak vars above.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
