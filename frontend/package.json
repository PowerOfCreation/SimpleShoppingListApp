{
  "name": "sholist",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@12.13.0",
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "start:prod": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:dev": "APP_VARIANT=development expo run:android",
    "android:prod": "expo run:android --variant release",
    "android:prod:apk": "expo prebuild --clean && cd android && ./gradlew assembleRelease && cd .. && adb install -r android/app/build/outputs/apk/release/app-release.apk && APP_VARIANT=development expo prebuild --clean",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --coverage --silent",
    "test:ci": "jest --coverage --silent --ci",
    "test:debug": "jest --coverage",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix && tsc --noEmit"
  },
  "dependencies": {
    "@expo/dom-webview": "^58.0.0",
    "@expo/metro-runtime": "58.0.14",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.16",
    "expo-application": "~58.1.0",
    "expo-auth-session": "58.0.13",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "~58.0.0",
    "expo-device": "58.0.5",
    "expo-font": "58.0.9",
    "expo-linking": "58.0.13",
    "expo-network": "~58.0.0",
    "expo-router": "58.0.24",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.10",
    "expo-sqlite": "58.0.13",
    "expo-status-bar": "58.0.3",
    "expo-system-ui": "58.0.6",
    "expo-web-browser": "58.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-get-random-values": "1.11.0",
    "react-native-popup-menu": "0.19.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@react-native/eslint-plugin": "0.87.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.11.0",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-native": "5.0.0",
    "expo-build-properties": "58.0.11",
    "expo-doctor": "1.21.4",
    "expo-sqlite-mock": "4.0.0",
    "globals": "17.13.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "jest-junit": "17.0.0",
    "prettier": "3.9.10",
    "test-renderer": "1.3.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "uuid"
        ]
      }
    }
  }
}
