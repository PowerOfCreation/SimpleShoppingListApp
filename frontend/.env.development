# Loaded by Expo for development builds (pnpm start / android:dev).
# 10.0.2.2 is the Android emulator's alias for the host machine's localhost.
# On a physical device over USB, use `adb reverse tcp:8080 tcp:8080` and
# leave this as-is, or point it at the device's LAN-reachable host instead.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
